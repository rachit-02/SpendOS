# SpendOS Environment Configuration
# 
# IMPORTANT: This is an example file (.env.example)
# 
# For LOCAL DEVELOPMENT:
# 1. Copy this file to .env
# 2. Update values as needed for your environment
# 3. .env should NEVER be committed to Git
#
# For PRODUCTION:
# Set environment variables through your deployment platform
# (Docker, Kubernetes, Cloud Platform, etc.)
# NEVER store secrets in .env files in production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]
DATABASE_URL=postgresql://spendos_user:spendos_password@localhost:5432/spendos

# PostgreSQL credentials (used if DATABASE_URL not set)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=spendos
DATABASE_USERNAME=spendos_user
DATABASE_PASSWORD=CHANGE_ME_IN_LOCAL_DEV

# PostgreSQL connection pool settings
DATABASE_HIKARI_MAXIMUM_POOL_SIZE=20
DATABASE_HIKARI_MINIMUM_IDLE=5
DATABASE_HIKARI_CONNECTION_TIMEOUT=30000
DATABASE_HIKARI_IDLE_TIMEOUT=600000
DATABASE_HIKARI_MAX_LIFETIME=1800000

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Secret - MUST be at least 32 characters in production
# Generate a random secret: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG_RANDOM_STRING_IN_PRODUCTION

# JWT token expiration times (in milliseconds)
JWT_ACCESS_TOKEN_EXPIRATION=3600000      # 1 hour
JWT_REFRESH_TOKEN_EXPIRATION=2592000000  # 30 days

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment: development, staging, production
APP_ENV=development

# Application name
APP_NAME=SpendOS

# Application port
APP_PORT=8080

# Application URL (used for email links, redirects, etc.)
APP_URL=http://localhost:3000

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend port (Vite dev server)
FRONTEND_PORT=3000

# Frontend build output directory
FRONTEND_BUILD_DIR=dist

# ============================================================================
# CORS & HTTP SETTINGS
# ============================================================================

# Comma-separated list of allowed origins for CORS
# Format: http://localhost:3000,https://example.com
# IMPORTANT: Never use * in production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable CORS credentials (cookies, authorization headers)
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# HTTPS enforcement (only disable for local development)
HTTPS_ENABLED=false

# Security header settings
SECURITY_HEADERS_ENABLED=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_AUTH_ATTEMPTS_PER_15MIN=5

# CSRF protection (JWT-based, so minimal config needed)
CSRF_ENABLED=true

# ============================================================================
# REDIS CONFIGURATION (Optional, for caching)
# ============================================================================

# Redis enabled for caching
REDIS_ENABLED=false

# Redis connection string
REDIS_URL=redis://localhost:6379

# Redis credentials (if needed)
REDIS_USERNAME=
REDIS_PASSWORD=

# Redis database number
REDIS_DATABASE=0

# Cache TTL settings (in seconds)
CACHE_DASHBOARD_TTL=300        # 5 minutes
CACHE_ANALYTICS_TTL=3600       # 1 hour
CACHE_INSIGHTS_TTL=1800        # 30 minutes

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Log output format
LOG_FORMAT=json  # or 'text'

# Log file path (leave empty to log to console only)
LOG_FILE_PATH=

# Maximum log file size before rotation (in MB)
LOG_FILE_MAX_SIZE=100

# Number of log files to keep
LOG_FILE_MAX_FILES=10

# ============================================================================
# EMAIL CONFIGURATION (Optional, for future notifications)
# ============================================================================

# Email provider: smtp, sendgrid, mailgun, ses
EMAIL_PROVIDER=smtp

# SMTP settings
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@spendos.com
SMTP_FROM_NAME=SpendOS

# Email notifications enabled
EMAIL_NOTIFICATIONS_ENABLED=false

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================

# Maximum file upload size (in bytes)
FILE_UPLOAD_MAX_SIZE=52428800  # 50 MB

# Allowed file types for import
FILE_UPLOAD_ALLOWED_TYPES=text/csv,text/plain

# Temporary file directory
FILE_UPLOAD_TEMP_DIR=/tmp/spendos

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Feature flags for new features
FEATURE_AI_ASSISTANT_ENABLED=true
FEATURE_RECURRING_DETECTION_ENABLED=true
FEATURE_ANOMALY_DETECTION_ENABLED=true
FEATURE_MONEY_LEAK_DETECTION_ENABLED=true
FEATURE_SPENDING_PREDICTION_ENABLED=true
FEATURE_HEALTH_SCORE_ENABLED=true

# ============================================================================
# INTEGRATIONS (Future)
# ============================================================================

# LLM Integration (for AI assistant)
# LLM_PROVIDER=openai  # or 'anthropic', 'local', etc.
# LLM_API_KEY=CHANGE_ME
# LLM_MODEL=gpt-4

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Error tracking (Sentry)
SENTRY_ENABLED=false
SENTRY_DSN=

# Application Performance Monitoring
APM_ENABLED=false
APM_SERVICE_NAME=spendos
APM_ENVIRONMENT=development

# ============================================================================
# DATABASE MIGRATION
# ============================================================================

# Flyway migration settings
FLYWAY_ENABLED=true
FLYWAY_AUTO_MIGRATION=true
FLYWAY_MIGRATION_VALIDATION_MODE=INFO

# ============================================================================
# DEMO MODE SETTINGS
# ============================================================================

# Enable demo mode with synthetic data
DEMO_MODE_ENABLED=false

# Demo user credentials
DEMO_USER_EMAIL=demo@spendos.com
DEMO_USER_PASSWORD=DemoPassword123!

# ============================================================================
# TIME & LOCALE SETTINGS
# ============================================================================

# Default timezone (IANA format)
DEFAULT_TIMEZONE=Asia/Kolkata

# Default currency code (ISO 4217)
DEFAULT_CURRENCY=INR

# Default language
DEFAULT_LANGUAGE=en

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Debug mode (only for development)
DEBUG_MODE=false

# Database initialization mode: create, update, validate
# IMPORTANT: Set to 'validate' in production
JPA_HIBERNATE_DDL_AUTO=validate

# Show SQL queries (only for development)
JPA_SHOW_SQL=false

# Format SQL queries for readability (only for development)
JPA_FORMAT_SQL=false

# ============================================================================
# NOTES
# ============================================================================

# 1. SECURITY:
#    - Never commit this file with real values
#    - Use a template (.env.example) for version control
#    - Rotate secrets regularly
#    - Use strong, random passwords

# 2. DATABASE:
#    - Ensure PostgreSQL is accessible at the specified URL
#    - User must have permission to create/alter tables
#    - Use SSL in production

# 3. ENVIRONMENT VARIABLES:
#    - Production should use platform-managed secrets
#    - Never log sensitive values
#    - Validate all configuration on startup

# 4. CORS:
#    - Be restrictive in production
#    - List only necessary origins
#    - Use credentials only when needed

# 5. JWT SECRET:
#    - Generate: openssl rand -base64 32
#    - Must be at least 32 characters
#    - Change periodically
#    - Never share or commit

