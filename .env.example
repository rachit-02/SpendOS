# SpendOS environment variables
#
# Copy to .env and edit:  cp .env.example .env
# .env is gitignored and must never be committed. This file holds placeholders only.
#
# Every variable below is read by the application, docker-compose or the frontend build.
# Values shown are the built-in defaults, which are fine for local development.
# See DEPLOYMENT.md for the production checklist.

# ============================================================================
# REQUIRED IN PRODUCTION (no defaults there; the app refuses to start with placeholders)
# ============================================================================

# JDBC URL of the PostgreSQL database.
DATABASE_URL=jdbc:postgresql://localhost:5432/spendos
DATABASE_USERNAME=spendos_user
# Database name created by the docker-compose postgres container.
DATABASE_NAME=spendos
# Changing this after the database volume exists also needs an ALTER ROLE (see DEPLOYMENT.md).
DATABASE_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD

# Signing key for access and refresh tokens: at least 32 bytes of randomness.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG_RANDOM_STRING_IN_PRODUCTION

# "production" turns on the startup check that rejects placeholder secrets.
APP_ENV=development
# Public origin of the app; used for links.
APP_URL=http://localhost:3000
# Required when APP_ENV=production (prod profile has no default).
# APP_PRODUCTION_URL=https://spendos.example.com
# Comma-separated list; wildcards are ignored.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# PORTS (docker-compose host ports; change when one is already in use)
# ============================================================================

BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432
# Port the backend listens on inside its container.
APP_PORT=8080

# ============================================================================
# APPLICATION
# ============================================================================

APP_NAME=SpendOS
JWT_ISSUER=spendos
# Milliseconds: 1 hour and 30 days.
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=2592000000

# Statement upload limit in bytes (50 MB). nginx allows 51 MB.
FILE_UPLOAD_MAX_SIZE=52428800

# Rate limits from SECURITY.md. Only disable on a private stack, e.g. for load testing.
RATE_LIMIT_ENABLED=true

# Swagger UI at /api/swagger-ui.html. Keep false in production.
SWAGGER_ENABLED=true

# Flyway database migrations run at startup.
FLYWAY_ENABLED=true

# Daily purge of accounts deleted 30+ days ago and demo accounts older than a day (cron).
USERS_PURGE_SCHEDULE=0 30 3 * * *

# ============================================================================
# DATABASE CONNECTION POOL (HikariCP)
# ============================================================================

DATABASE_HIKARI_MAXIMUM_POOL_SIZE=20
DATABASE_HIKARI_MINIMUM_IDLE=5
DATABASE_HIKARI_CONNECTION_TIMEOUT=30000
DATABASE_HIKARI_IDLE_TIMEOUT=600000
DATABASE_HIKARI_MAX_LIFETIME=1800000

# ============================================================================
# CACHING (Redis is optional; the in-process cache is used by default)
# ============================================================================

CACHE_TYPE=simple
REDIS_ENABLED=false
# Used by docker-compose for the optional Redis container.
REDIS_PASSWORD=CHANGE_ME_IF_REDIS_ENABLED

# ============================================================================
# FEATURE FLAGS
# ============================================================================

FEATURE_AI_ASSISTANT_ENABLED=true
FEATURE_DEMO_MODE_ENABLED=true
FEATURE_RECURRING_DETECTION_ENABLED=true
FEATURE_ANOMALY_DETECTION_ENABLED=true
FEATURE_MONEY_LEAK_DETECTION_ENABLED=true
FEATURE_SPENDING_PREDICTION_ENABLED=true
FEATURE_HEALTH_SCORE_ENABLED=true

# ============================================================================
# AI ASSISTANT (optional, off by default)
# ============================================================================
# Answers are always computed by the backend. With this enabled, the question, the draft
# answer and aggregated findings are sent to Anthropic for rewording, and any reworded text
# containing a number the backend did not supply is discarded.
# Enabling it without an API key stops startup.

ASSISTANT_LLM_ENABLED=false
# ANTHROPIC_API_KEY=CHANGE_ME
ASSISTANT_LLM_MODEL=claude-haiku-4-5-20251001
ASSISTANT_LLM_BASE_URL=https://api.anthropic.com
ASSISTANT_LLM_TIMEOUT=8s

# ============================================================================
# FRONTEND
# ============================================================================

# Where the browser sends API calls. Default: same origin, proxied by nginx at /api/v1.
# VITE_API_BASE_URL=/api/v1
# Dev server only: where `npm run dev` proxies /api to.
VITE_API_PROXY_TARGET=http://localhost:8080
# Playwright end-to-end tests: the running stack to test against.
E2E_BASE_URL=http://localhost:3000

# ============================================================================
# LOGGING
# ============================================================================

LOG_FILE_MAX_SIZE=100MB
LOG_FILE_MAX_FILES=10

# ============================================================================
# TLS (only when the backend terminates HTTPS itself; usually done by a proxy)
# ============================================================================

SSL_ENABLED=false
# SSL_KEYSTORE_PATH=/etc/spendos/keystore.p12
# SSL_KEYSTORE_PASSWORD=CHANGE_ME

# ============================================================================
# NOT IMPLEMENTED YET
# ============================================================================
# Nothing reads these; they are listed so the roadmap is visible. Setting them has no effect.
#   Email (monthly reports, budget alerts): SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD,
#     SMTP_FROM_EMAIL, SMTP_FROM_NAME, EMAIL_PROVIDER, EMAIL_NOTIFICATIONS_ENABLED
#   Error tracking / monitoring: SENTRY_DSN, SENTRY_ENABLED, APM_ENABLED, APM_SERVICE_NAME,
#     APM_ENVIRONMENT
